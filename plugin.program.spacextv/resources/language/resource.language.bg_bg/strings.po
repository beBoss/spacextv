msgctxt "#30000"
msgid "SpaceXTV"
msgstr "SpaceXTV"

msgctxt "#30001"
msgid "Account"
msgstr "Акаунт"

msgctxt "#30002"
msgid "Updates & TV guide"
msgstr "Обновяване и ТВ програма"

msgctxt "#30003"
msgid "Channels"
msgstr "Канали"

msgctxt "#30004"
msgid "Advanced"
msgstr "Разширени"

msgctxt "#30005"
msgid "Tools"
msgstr "Инструменти"

msgctxt "#30010"
msgid "Log in with username and password"
msgstr "Вход с потребителско име и парола"

msgctxt "#30011"
msgid "Username"
msgstr "Потребителско име"

msgctxt "#30012"
msgid "Password"
msgstr "Парола"

msgctxt "#30013"
msgid "Login file URL (folder with login.txt)"
msgstr "Адрес на файл за вход (папка с login.txt)"

msgctxt "#30014"
msgid "Device profile"
msgstr "Профил на устройството"

msgctxt "#30015"
msgid "Samsung TV"
msgstr "Samsung TV"

msgctxt "#30016"
msgid "Android TV"
msgstr "Android TV"

msgctxt "#30017"
msgid "Catch-up / replay (uses Android TV profile)"
msgstr "Гледане назад (използва профил Android TV)"

msgctxt "#30020"
msgid "Refresh channel list automatically (before stream links expire)"
msgstr "Автоматично обновяване на каналите (преди линковете да изтекат)"

msgctxt "#30021"
msgid "Refresh channel list every (minutes)"
msgstr "Обновяване на каналите на всеки (минути)"

msgctxt "#30022"
msgid "Use my own EPG source (don't download the TV guide)"
msgstr "Собствен източник на ТВ програма (без изтегляне)"

msgctxt "#30023"
msgid "Refresh TV guide every (hours)"
msgstr "Обновяване на ТВ програмата на всеки (часа)"

msgctxt "#30024"
msgid "TV guide days ahead (fewer = faster)"
msgstr "Дни ТВ програма напред (по-малко = по-бързо)"

msgctxt "#30025"
msgid "Reload Live TV when the channel list changes"
msgstr "Презареждане на телевизията при промяна в каналите"

msgctxt "#30026"
msgid "Show progress bar during background updates"
msgstr "Показване на прогреса при обновяване във фонов режим"

msgctxt "#30030"
msgid "Show adult channels (18+)"
msgstr "Показване на канали за възрастни (18+)"

msgctxt "#30031"
msgid "Group channels by genre"
msgstr "Групиране на каналите по жанр"

msgctxt "#30032"
msgid "Add User-Agent to stream links (recommended)"
msgstr "Добавяне на User-Agent към линковете (препоръчително)"

msgctxt "#30033"
msgid "Use custom channel logos"
msgstr "Собствени лога на каналите"

msgctxt "#30034"
msgid "Logos are in a local folder"
msgstr "Логата са в локална папка"

msgctxt "#30035"
msgid "Logos web address (URL)"
msgstr "Уеб адрес на логата (URL)"

msgctxt "#30036"
msgid "Local logos folder"
msgstr "Локална папка с лога"

msgctxt "#30040"
msgid "Login retry attempts"
msgstr "Опити за вход"

msgctxt "#30041"
msgid "Network timeout (seconds)"
msgstr "Изчакване на мрежата (секунди)"

msgctxt "#30042"
msgid "Debug logging"
msgstr "Подробен дневник (debug)"

msgctxt "#30043"
msgid "Also copy playlist and TV guide to a folder"
msgstr "Копиране на плейлистата и ТВ програмата в папка"

msgctxt "#30044"
msgid "Copy to folder"
msgstr "Папка за копиране"

msgctxt "#30045"
msgid "Run a command after each update"
msgstr "Изпълнение на команда след всяко обновяване"

msgctxt "#30046"
msgid "Kodi built-in command"
msgstr "Вградена команда на Kodi"

msgctxt "#30047"
msgid "System command / script"
msgstr "Системна команда / скрипт"

msgctxt "#30050"
msgid "Update channels and TV guide now"
msgstr "Обнови каналите и ТВ програмата сега"

msgctxt "#30051"
msgid "Set up Live TV (PVR IPTV Simple)"
msgstr "Настрой телевизията (PVR IPTV Simple)"

msgctxt "#30052"
msgid "Files for PVR IPTV Simple Client (Local path):"
msgstr "Файлове за PVR IPTV Simple Client (локален път):"

msgctxt "#30053"
msgid "SpaceXTV by Blagovest Klisarski  -  blagovestklisarski.com"
msgstr "SpaceXTV от Blagovest Klisarski  -  blagovestklisarski.com"

msgctxt "#30100"
msgid "Welcome to SpaceXTV![CR][CR]Sign in with your Bulsat account and your channels will be ready in about a minute."
msgstr "Добре дошли в SpaceXTV![CR][CR]Влезте с акаунта си в Bulsat и каналите ще са готови до около минута."

msgctxt "#30101"
msgid "Later"
msgstr "По-късно"

msgctxt "#30102"
msgid "Sign in"
msgstr "Вход"

msgctxt "#30103"
msgid "Bulsat username"
msgstr "Потребителско име за Bulsat"

msgctxt "#30104"
msgid "Password"
msgstr "Парола"

msgctxt "#30105"
msgid "To sign in, open SpaceXTV from Add-ons"
msgstr "За вход отворете SpaceXTV от Добавки"

msgctxt "#30106"
msgid "Login failed - check username and password"
msgstr "Неуспешен вход - проверете потребителското име и паролата"

msgctxt "#30107"
msgid "Update failed - no internet? Retrying in a few minutes"
msgstr "Неуспешно обновяване - няма интернет? Нов опит след няколко минути"

msgctxt "#30108"
msgid "Settings imported from Space Plug-In"
msgstr "Настройките са прехвърлени от Space Plug-In"

msgctxt "#30109"
msgid "Old Space Plug-In switched off - you can uninstall it"
msgstr "Старият Space Plug-In е изключен - може да го деинсталирате"

msgctxt "#30110"
msgid "Live TV now uses SpaceXTV"
msgstr "Телевизията вече използва SpaceXTV"

msgctxt "#30111"
msgid "All set! %d channels - open TV in the Kodi main menu"
msgstr "Готово! %d канала - отворете Телевизия от главното меню"

msgctxt "#30112"
msgid "Install \"PVR IPTV Simple Client\", then open SpaceXTV > Set up Live TV"
msgstr "Инсталирайте „PVR IPTV Simple Client“, после SpaceXTV > Настрой телевизията"

msgctxt "#30113"
msgid "Please finish signing in in the open window"
msgstr "Довършете входа в отворения прозорец"

msgctxt "#30114"
msgid "updated %s, %s channels"
msgstr "обновено %s, %s канала"

msgctxt "#30115"
msgid "not updated yet"
msgstr "още не е обновено"

msgctxt "#30117"
msgid "Sign in and load channels"
msgstr "Вход и зареждане на каналите"

msgctxt "#30119"
msgid "Settings"
msgstr "Настройки"

msgctxt "#30120"
msgid "Run \"Update now\" first"
msgstr "Първо обновете каналите"

msgctxt "#30121"
msgid "Live TV is already set up"
msgstr "Телевизията вече е настроена"

msgctxt "#30122"
msgid "Live TV set up - channels are loading"
msgstr "Телевизията е настроена - каналите се зареждат"

msgctxt "#30123"
msgid "An update is already running, please wait"
msgstr "Вече тече обновяване, моля изчакайте"

msgctxt "#30125"
msgid "Update failed - check your internet connection"
msgstr "Неуспешно обновяване - проверете интернет връзката"

msgctxt "#30126"
msgid "Channels updated (%d), TV guide failed - try again later"
msgstr "Каналите са обновени (%d), ТВ програмата не успя - опитайте по-късно"

msgctxt "#30127"
msgid "Done: %d channels, TV guide %d days"
msgstr "Готово: %d канала, ТВ програма за %d дн."

msgctxt "#30128"
msgid "Done: %d channels"
msgstr "Готово: %d канала"

msgctxt "#30129"
msgid "Live TV is not set up yet - choose \"Set up Live TV\""
msgstr "Телевизията още не е настроена - изберете „Настрой телевизията“"

msgctxt "#30130"
msgid "Done"
msgstr "Готово"

msgctxt "#30131"
msgid "Install \"PVR IPTV Simple Client\" first"
msgstr "Първо инсталирайте „PVR IPTV Simple Client“"

msgctxt "#30140"
msgid "Signing in..."
msgstr "Вход..."

msgctxt "#30141"
msgid "Loading channel list..."
msgstr "Зареждане на каналите..."

msgctxt "#30142"
msgid "Building playlist..."
msgstr "Създаване на плейлистата..."

msgctxt "#30143"
msgid "TV guide starts in a moment..."
msgstr "ТВ програмата започва след малко..."

msgctxt "#30144"
msgid "Downloading TV guide..."
msgstr "Изтегляне на ТВ програмата..."

msgctxt "#30145"
msgid "TV guide %d/%d  %s"
msgstr "ТВ програма %d/%d  %s"

msgctxt "#30146"
msgid "Saving TV guide..."
msgstr "Записване на ТВ програмата..."

msgctxt "#30147"
msgid "Updating..."
msgstr "Обновяване..."

msgctxt "#30148"
msgid "Starting..."
msgstr "Стартиране..."

msgctxt "#30149"
msgid "Enter your login first"
msgstr "Първо въведете данните си за вход"

msgctxt "#30150"
msgid "Switching Live TV to the new channel list..."
msgstr "Превключване на телевизията към новите канали..."

msgctxt "#30151"
msgid "Loading channels into Live TV, please wait..."
msgstr "Зареждане на каналите в телевизията, моля изчакайте..."

msgctxt "#30154"
msgid "Installing PVR IPTV Simple Client..."
msgstr "Инсталиране на PVR IPTV Simple Client..."

msgctxt "#30155"
msgid "Live TV is still loading - give it a minute. No channels? SpaceXTV > Update now"
msgstr "Телевизията още се зарежда - изчакайте минута. Няма канали? SpaceXTV > Обнови каналите"

msgctxt "#30160"
msgid "Show SpaceXTV log"
msgstr "Покажи дневника на SpaceXTV"

msgctxt "#30161"
msgid "No SpaceXTV entries in the Kodi log yet."
msgstr "Все още няма записи от SpaceXTV в дневника на Kodi."

msgctxt "#30170"
msgid "Channels stopped working - getting fresh links..."
msgstr "Каналите спряха да работят - взимам нови връзки..."

msgctxt "#30171"
msgid "Channels work again - pick a channel"
msgstr "Каналите работят отново - изберете канал"

msgctxt "#30172"
msgid "Channels work again - starting %s"
msgstr "Каналите работят отново - пускам %s"

msgctxt "#30173"
msgid "Bulsat refuses the channels - is your account in use on another device? Next try in 30 min"
msgstr "Bulsat отказва каналите - акаунтът ползва ли се на друго устройство? Нов опит след 30 мин."
